# LLM Providers Configuration
# Obtain Gemini key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Obtain Groq key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Selected LLM provider: 'gemini' or 'groq'
LLM_PROVIDER=gemini

# Selected LLM Model
# Gemini: 'gemini-1.5-flash' or 'gemini-1.5-pro'
# Groq: 'llama3-8b-8192'
LLM_MODEL=gemini-1.5-flash

# Default Voice configuration (e.g. en-US-EmmaMultilingualNeural, en-GB-SoniaNeural, etc.)
DEFAULT_VOICE=en-US-EmmaMultilingualNeural
PORT=8000
